---
// Leistungsseite „Websites und SEO“ (Relaunch): neues Erscheinungsbild unter der bisherigen Adresse.
// Inhalte in src/lib/seiten.ts; SEO-Kopf (Titel, Beschreibung, JSON-LD) aus der übernommenen Seite.
import Seite from '../layouts/Seite.astro';
import { websitesSeite } from '../lib/seiten';
import { TITEL } from '../lib/geo';
import alt from '../legacy/pages/professionelle-websites-fuer-den-mittelstand.json';

const t = TITEL['/professionelle-websites-fuer-den-mittelstand/'].replace(/&/g, '&amp;').replace(/"/g, '&quot;');
const seo = alt.seo
  .replace(/<title>[^<]*<\/title>/, `<title>${t}</title>`)
  .replace(/(<meta (?:name|property)="(?:og:title|twitter:title)" content=")[^"]*/g, `$1${t}`)
  .replace(/<meta name="twitter:(?:label|data)\d" content="[^"]*" \/>\n?/g, '');
---
<Seite seo={seo} main={websitesSeite()} />
