---
// Fehlerseite „Seite nicht gefunden“ (Apache: ErrorDocument 404 in public/.htaccess) im neuen Erscheinungsbild.
// Die frühere Fassung mit Comic-Fuchs steht in der Git-Historie (vor dem Relaunch-Erscheinungsbild).
import Seite from '../layouts/Seite.astro';
import { CONTENT, SOCIAL, WEB } from '../lib/chrome';

const seo = `<title>Seite nicht gefunden – thinkfox marketing</title>
<meta name="robots" content="noindex, follow"/>`;
const ziele: [string, string, string][] = [
  ['/', 'Startseite', 'Überblick über thinkfox und alle Leistungen'],
  [WEB, 'Websites und SEO', 'Unternehmenswebsites, die gefunden werden'],
  [SOCIAL, 'Social Media', 'Betreuung Ihrer Kanäle'],
  [CONTENT, 'Film und Foto', 'Imagefilm, Recruitingfilm, Fotografie'],
  ['/referenzen/', 'Referenzen', 'Projekte für unsere Kunden'],
  ['/blog/', 'Ratgeber', 'Kosten, Vorgehen und Hintergründe'],
];
const main = `<section class="t1 t1--unterseite t1--ohne-bild" aria-labelledby="titel">
    <div class="huelle">
      <ul class="t1__meta" role="list"><li>Fehler 404</li></ul>
      <div class="raster">
        <h1 id="titel">Seite nicht gefunden</h1>
        <div class="t1__unten"><p class="t1__text">Die aufgerufene Adresse gibt es nicht oder nicht mehr. Über die folgenden Seiten finden Sie weiter.</p></div>
      </div>
    </div>
  </section>
  <section class="abschnitt abschnitt--knapp" aria-label="Weiterführende Seiten">
    <div class="huelle raster">
      <p class="label sp-label">Weiter</p>
      <ul class="sp-inhalt zeilen zeilen--eng" role="list" style="margin-top:0">
        ${ziele.map(([href, titel, text]) => `<li class="zeile"><h2 style="font-size:1.375rem;letter-spacing:-0.02em"><a class="link" href="${href}">${titel}</a></h2><p>${text}</p></li>`).join('')}
      </ul>
    </div>
  </section>`;
---
<Seite seo={seo} main={main} />
