---
// Alle Seiten (übernommenes Elementor-Markup) und Beiträge (Projekte + Blog) unter ihrer
// bisherigen URL: /<slug>/ bzw. /360-grad-rundgaenge/<slug>/
import Legacy from '../layouts/Legacy.astro';
import Seite from '../layouts/Seite.astro';
import { LEISTUNGSSEITEN, leistungsSeite } from '../lib/leistungen';
import { seoNeu } from '../lib/seiten';
import { referenzSeite } from '../lib/referenz';
import { SONDERSEITEN } from '../lib/weitere-seiten';
import { istFormularseite, sieForm, sieFormSkript } from '../lib/formularseiten';
import {
  allPosts, imOriginal, originalSeite, originalStyles, pageFiles, renderInstagram, renderLoops, renderReferenzen, type LegacyPage, type Post,
} from '../lib/wp';
import { seoHead } from '../lib/seo';
import { renderHeroVideos } from '../lib/hero-video';
import { BESCHREIBUNGEN, TITEL, jsonLdTexte } from '../lib/geo';
import { beitragSeite, beitragStyles, mitWeiteren, weitereProjekte } from '../lib/beitrag';

export async function getStaticPaths() {
  // Startseite: eigene Datei im neuen Erscheinungsbild (src/pages/index.astro); index.json bleibt Archiv
  const pages = Object.values(pageFiles).map((m) => m.default as LegacyPage);
  const posts = await allPosts();
  return [
    ...pages.filter((page) => page.path !== '/').map((page) => ({
      params: { slug: page.path === '/' ? undefined : page.path.replace(/^\/|\/$/g, '') },
      props: { page },
    })),
    ...posts.map((post) => ({ params: { slug: post.id }, props: { post } })),
  ];
}

const { page, post } = Astro.props as { page?: LegacyPage; post?: Post };

let seo: string, styles, scripts, bodyClass: string, main: string, canvas = false, einheitlich = true;
// Leistungsseiten im neuen Erscheinungsbild (src/lib/leistungen.ts): eigener Inhalt, SEO-Kopf der bisherigen Seite
const sonder = page ? SONDERSEITEN[page.path] : undefined;
const neuesLayout = !page || page.path in LEISTUNGSSEITEN || !!sonder;
let css: string[] = [];
if (page) {
  seo = page.seo;
  const neu = BESCHREIBUNGEN[page.path];
  if (neu) {
    seo = seo.replace(/(<meta (?:name|property)="(?:description|og:description|twitter:description)" content=")[^"]*/g, `$1${neu.replace(/"/g, '&quot;')}`);
  }
  const titel = TITEL[page.path];
  if (titel) {
    const t = titel.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
    seo = seo.replace(/<title>[^<]*<\/title>/, `<title>${t}</title>`)
      .replace(/(<meta (?:name|property)="(?:og:title|twitter:title)" content=")[^"]*/g, `$1${t}`);
  }
  seo = jsonLdTexte(seo, { beschreibung: neu, titel });
  styles = page.styles;
  scripts = page.scripts;
  bodyClass = page.bodyClass;
  canvas = page.canvas;
  if (neuesLayout) {
    seo = seoNeu(seo);
    main = sonder ? await sonder(page) : leistungsSeite(page.path);
  } else {
    main = renderHeroVideos(renderInstagram(await renderReferenzen(await renderLoops(page.main))));
    // Formularseiten (Forminator) bleiben im Elementor-Rahmen: Texte in Sie-Form, Gestaltung über formular.css
    if (istFormularseite(page.path)) {
      main = sieForm(page.path, main);
      scripts = scripts.map((x) => (x.inline ? { ...x, inline: sieFormSkript(x.inline) } : x));
    }
  }
} else {
  const p = post!;
  seo = seoHead(p);
  if (p.collection === 'projekte') {
    // Referenzen im neuen Erscheinungsbild (src/lib/referenz.ts)
    ({ main } = await referenzSeite(p));
  } else {
    // Blog im einheitlichen Beitragslayout (src/lib/beitrag.ts + beitrag.css), ohne Elementor
    main = await beitragSeite(p);
    css = ['/css/beitrag.css'];
  }
}
---
{neuesLayout
  ? <Seite seo={seo} main={main} css={css} />
  : <Legacy seo={seo} styles={styles} scripts={scripts} bodyClass={bodyClass} main={main} canvas={canvas} einheitlich={einheitlich} />}
