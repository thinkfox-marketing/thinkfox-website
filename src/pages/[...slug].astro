---
// Alle Seiten (übernommenes Elementor-Markup) und Beiträge (Projekte + Blog) unter ihrer
// bisherigen URL: /<slug>/ bzw. /360-grad-rundgaenge/<slug>/
import Legacy from '../layouts/Legacy.astro';
import {
  allPosts, imOriginal, originalSeite, originalStyles, pageFiles, renderInstagram, renderLoops, renderReferenzen, type LegacyPage, type Post,
} from '../lib/wp';
import { seoHead } from '../lib/seo';
import { renderHeroVideos } from '../lib/hero-video';
import { BESCHREIBUNGEN } from '../lib/geo';
import { beitragSeite, beitragStyles } from '../lib/beitrag';

export async function getStaticPaths() {
  const pages = Object.values(pageFiles).map((m) => m.default as LegacyPage);
  const posts = await allPosts();
  return [
    ...pages.map((page) => ({
      params: { slug: page.path === '/' ? undefined : page.path.replace(/^\/|\/$/g, '') },
      props: { page },
    })),
    ...posts.map((post) => ({ params: { slug: post.id }, props: { post } })),
  ];
}

const { page, post } = Astro.props as { page?: LegacyPage; post?: Post };

let seo: string, styles, scripts, bodyClass: string, main: string, canvas = false, einheitlich = true;
if (page) {
  seo = page.seo;
  const neu = BESCHREIBUNGEN[page.path];
  if (neu) {
    seo = seo.replace(/(<meta (?:name|property)="(?:description|og:description|twitter:description)" content=")[^"]*/g, `$1${neu.replace(/"/g, '&quot;')}`);
  }
  styles = page.styles;
  scripts = page.scripts;
  bodyClass = page.bodyClass;
  canvas = page.canvas;
  main = renderHeroVideos(renderInstagram(await renderReferenzen(await renderLoops(page.main))));
} else {
  const p = post!;
  seo = seoHead(p);
  if (imOriginal(p)) {
    // Projekte vorerst 1:1 wie im Original (src/lib/wp.ts, PROJEKTE_IM_ORIGINAL)
    ({ styles, scripts, bodyClass } = originalStyles(p));
    main = originalSeite(p);
    einheitlich = false;
  } else {
    // Blog (und neue Projekte) im einheitlichen Layout (src/lib/beitrag.ts)
    ({ styles, scripts, bodyClass } = beitragStyles(p));
    main = await beitragSeite(p);
  }
}
---
<Legacy seo={seo} styles={styles} scripts={scripts} bodyClass={bodyClass} main={main} canvas={canvas} einheitlich={einheitlich} />
