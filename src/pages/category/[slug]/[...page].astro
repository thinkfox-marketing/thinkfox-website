---
// Kategorie-Archive im neuen Erscheinungsbild, 10 Beiträge pro Seite wie in WordPress (gleiche Adressen):
// /category/<slug>/ und /category/<slug>/page/<n>/
import Seite from '../../../layouts/Seite.astro';
import taxonomies from '../../../legacy/taxonomies.json';
import { allPosts } from '../../../lib/wp';
import { KONTAKT, esc } from '../../../lib/seiten';
import { kachel } from '../../../lib/referenz';
import { beitragKachel } from '../../../lib/weitere-seiten';


export async function getStaticPaths() {
  const PER_PAGE = 10; // wie „Blogseiten zeigen maximal“ in WordPress
  const posts = await allPosts();
  return taxonomies.kategorien.flatMap((k) => {
    const all = posts.filter((p) => p.data.kategorien.includes(k.slug));
    const pages = Math.ceil(all.length / PER_PAGE);
    return Array.from({ length: pages }, (_, i) => ({
      params: { slug: k.slug, page: i === 0 ? undefined : `page/${i + 1}` },
      props: { name: k.name, posts: all.slice(i * PER_PAGE, (i + 1) * PER_PAGE), current: i + 1, pages },
    }));
  });
}

const { name, posts, current, pages } = Astro.props;
const base = `/category/${Astro.params.slug}/`;
const pageUrl = (n: number) => (n === 1 ? base : `${base}page/${n}/`);
const prev = current > 1 ? `<a class="link" href="${pageUrl(current - 1)}">Zurück</a>` : '';
const next = current < pages ? `<a class="link" href="${pageUrl(current + 1)}">Weiter</a>` : '';
const main = `<section class="t1 t1--unterseite t1--ohne-bild" aria-labelledby="titel">
    <div class="huelle">
      <nav aria-label="Brotkrumen"><ol class="pfad" role="list"><li><a href="/">Start</a></li><li><a href="/referenzen/">Referenzen</a></li><li><span aria-current="page">${esc(name)}</span></li></ol></nav>
      <div class="raster"><h1 id="titel">${esc(name)}</h1></div>
    </div>
  </section>
  <section class="abschnitt abschnitt--knapp" aria-label="Beiträge">
    <div class="huelle">
      <div class="galerie">${posts.map((p) => (p.collection === 'blog' ? beitragKachel(p) : kachel(p))).join('')}</div>
      ${pages > 1 ? `<nav class="seiten" aria-label="Seiten">${prev}<span>Seite ${current} von ${pages}</span>${next}</nav>` : ''}
    </div>
  </section>
  ${KONTAKT}`;
const seo = `<title>${name} Archive${current > 1 ? ` - Seite ${current} von ${pages}` : ''} - thinkfox marketing</title>
<meta name="robots" content="noindex, follow"/>
<link rel="canonical" href="https://thinkfox.de${pageUrl(current)}" />`;
---
<Seite seo={seo} main={main} />
