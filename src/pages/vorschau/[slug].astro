---
// Vorschau des einheitlichen Beitrags-Layouts (src/lib/beitrag.ts) vor der Umstellung –
// für Suchmaschinen gesperrt, nicht in den Sitemaps.
import Legacy from '../../layouts/Legacy.astro';
import { allPosts, type Post } from '../../lib/wp';
import { beitragSeite, beitragStyles } from '../../lib/beitrag';
import { seoHead } from '../../lib/seo';

export async function getStaticPaths() {
  const VORSCHAU = ['recruitmentfilm-dwaz-wirtschaftskanzlei', 'die-externe-marketingabteilung-warum-kmu-ihr-marketing-neu-denken-sollten'];
  const posts = (await allPosts()).filter((p) => VORSCHAU.includes(p.id));
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { styles, scripts, bodyClass } = beitragStyles(post);
const seo = seoHead(post).replace(/<meta name="robots" content="[^"]*"\s*\/?>/, '<meta name="robots" content="noindex, nofollow" />');
const main = await beitragSeite(post);
---
<Legacy seo={seo} styles={styles} scripts={scripts} bodyClass={bodyClass} main={main} />
