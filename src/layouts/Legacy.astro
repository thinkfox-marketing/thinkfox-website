---
// Seitenrahmen im Markup der bisherigen WordPress/Elementor-Seite.
import Tracking from '../components/Tracking.astro';
import header from '../legacy/chrome/header.html?raw';
import footer from '../legacy/chrome/footer.html?raw';
import type { ScriptRef, StyleRef } from '../lib/wp';
import { asset } from '../lib/asset';
import { ebenenOhneSprung, einbettungen, fussEbenen, telefon, zugaenglich } from '../lib/barrierefreiheit';
import { trennstellen } from '../lib/umbruch';
import { bildMasse, spaetLaden, kachelnSpaet, ohneBildTitel } from '../lib/bilder';
import { cssBundle } from '../lib/css-bundle';
import { heroBild } from '../lib/hero-bild';
import { bewertungenStatisch } from '../lib/bewertungen';
import { strukturierteDaten, organisationAngleichen } from '../lib/geo';
import { megaMenue } from '../lib/megamenu';

interface Props {
  seo: string;          // <title>, Meta-Tags, JSON-LD
  styles: StyleRef[];
  scripts: ScriptRef[];
  bodyClass: string;
  main: string;
  canvas?: boolean;     // Elementor-Canvas: ohne Header/Footer
  einheitlich?: boolean; // false: ohne public/css/einheitlich.css (Projekte vorerst 1:1 im Original)
}
const { styles, scripts, bodyClass, canvas = false, einheitlich = true } = Astro.props;
// Unternehmensangaben im JSON-LD vereinheitlichen (src/lib/geo.ts)
// Gravatar-Bild des WordPress-Autors (Hash aus dessen E-Mail-Adresse) gehört nicht in die Strukturdaten
const seo = organisationAngleichen(Astro.props.seo).replace(/,"image":\{"@type":"ImageObject","@id":"https:\/\/secure\.gravatar\.com[^}]*\}/g, '');
// WordPress-AJAX-Endpunkt → eigener Endpunkt (public/api/ajax.php)
const ajax = (s: string) => s.replaceAll('/wp-admin/admin-ajax.php', '/api/ajax.php').replaceAll('\\/wp-admin\\/admin-ajax.php', '\\/api\\/ajax.php');
// Formulare immer per AJAX absenden (statt Seiten-POST an WordPress)
// Form-Trenner (Schrägen) aus dem inneren Kasten in den Container verschieben: Safari bemaß sie sonst
// nach der Inhaltsbreite statt der vollen Breite (weiße Kante links/rechts). In Chrome unverändert.
const trennerAussen = (s: string) => s.replace(
  /<div class="e-con-inner">(\s*)((?:<div class="elementor-shape elementor-shape-(?:top|bottom)"[^>]*>\s*<svg[\s\S]*?<\/svg>\s*<\/div>\s*)+)/g,
  (_m, ws, shapes) => `${shapes}<div class="e-con-inner">${ws}`,
);
const main = trennstellen(telefon(ebenenOhneSprung(zugaenglich(einbettungen(ajax(bewertungenStatisch(spaetLaden(ohneBildTitel(bildMasse(trennerAussen(Astro.props.main))))))))))).replace(
  /(class="forminator-ui forminator-custom-form forminator-custom-form-\d+ [^"]*?)(\s*")/g,
  (m, cls, end) => (cls.includes('forminator_ajax') ? m : `${cls} forminator_ajax${end}`),
);
// Beiträge (Elementor-Single-Vorlage) haben im Original kein <main> – Hauptbereich für Screenreader ergänzen
const mitMain = main.includes('<main');
const tag = (s: ScriptRef) => s.src
  ? `<script${s.id ? ` id="${s.id}"` : ''}${s.type ? ` type="${s.type}"` : ''} src="${s.src}"${s.async ? ' async' : ''}${s.defer ? ' defer' : ''}></script>`
  : `<script${s.id ? ` id="${s.id}"` : ''}${s.type ? ` type="${s.type}"` : ''}>${ajax(s.inline ?? '')}</script>`;
// WordPress-Emoji-Ersatz entfällt: aktuelle Geräte zeigen Emojis selbst an, ältere hätten
// die Grafiken von s.w.org (WordPress.org) geladen – ohne Einwilligung
const ohneEmoji = scripts.filter((s) => !/wp-emoji/.test(`${s.id ?? ''} ${s.src ?? ''} ${(s.inline ?? '').slice(0, 300)}`));
// Font Awesome nur, wenn die Seite fa-Klassen nutzt (alle Symbole sind sonst SVG) – spart 87 KB CSS + Skript im <head>
const mitFa = /class="[^"]*\bfa[srb]?\b[^"]*\bfa-[a-z]/.test(main + header + footer);
const ohneFa = (id?: string | null, url?: string | null) => !mitFa && /font-awesome|fontawesome|v4-shims/.test(`${id ?? ''} ${url ?? ''}`);
// Trustindex-Ladeskript entfällt (Bewertungen statisch, src/lib/bewertungen.ts)
const skripte = ohneEmoji.filter((s) => !ohneFa(s.id, s.src) && !/trustindex/.test(`${s.id ?? ''} ${s.src ?? ''}`));
// jQuery blockiert sonst das erste Zeichnen; einziger früher Nutzer war ein toter Schnipsel im Header (entfernt).
// Am Anfang des Body-Endes bleibt die Ausführungsreihenfolge gleich.
const JQUERY = /^jquery-(core|migrate)-js$/;
const headScripts = skripte.filter((s) => s.where === 'head' && !JQUERY.test(s.id ?? '')).map(tag).join('\n');
const bodyScripts = [...skripte.filter((s) => s.where === 'head' && JQUERY.test(s.id ?? '')), ...skripte.filter((s) => s.where === 'body')].map(tag).join('\n');
// Editor-CSS von Smash Balloon (nur Selektoren des Elementor-Editors) und ungenutztes Font Awesome weglassen
// … sowie das CSS des Termin-Popups (Popup entfällt: der Kalender öffnet direkt)
const stile = styles.filter((s) => s.id !== 'sb-elementor-shared-style-css' && s.id !== 'elementor-post-11357-css' && !ohneFa(s.id, s.type === 'link' ? s.href : null));

// Im Build: alle Stylesheets als eine Datei (src/lib/css-bundle.ts). Leere Platzhalter mit den
// Original-IDs bleiben stehen, weil Elementor nachgeladene Stile davor einfügt („before: #…-css“).
const bundle = import.meta.env.PROD ? cssBundle(stile, ['/css/ergaenzungen.css', '/css/megamenu.css', ...(einheitlich ? ['/css/einheitlich.css'] : [])]) : null;

// Hero mit Hintergrundvideo ganz oben: Standbild sofort laden (größtes sichtbares Element)
const ersterHero = main.indexOf('elementor-background-video-container');
const heroOben = ersterHero >= 0 && ersterHero < 6000;
const standbild = (name: string) => main.match(new RegExp(`/media/${name}\\.webp\\?v=[0-9a-f]+`))?.[0];
// Sonst: Hintergrundbild des ersten Abschnitts (CSS) sofort laden – der Browser fände es erst nach allen Stylesheets
const preloadDesktop = heroOben ? standbild('showreel-standbild') : undefined;
const preloadMobil = heroOben ? standbild('showreel-standbild-mobil') : undefined;
const heroBilder = heroOben ? [] : heroBild(main, stile);
const kachelCss = kachelnSpaet(main);

// Hausschriften (lateinischer Zeichensatz) sofort laden: sonst springt der Text, sobald die
// Schrift nach dem ersten Zeichnen eintrifft (font-display: swap → Layout-Verschiebung)
// (Poppins nicht: wird fast nirgends gerendert und lädt bei Bedarf selbst)
const SCHRIFTEN = [
  '/wp-content/uploads/elementor/google-fonts/fonts/outfit-97312486.woff2',
];

// Unternehmensprofil, Leistung, FAQ als JSON-LD (src/lib/geo.ts)
const beschreibung = seo.match(/<meta name="description" content="([^"]*)"/)?.[1];
const jsonLd = strukturierteDaten(Astro.url.pathname, main, beschreibung);

// Nach-oben-Knopf: im Original ein <span> ohne Namen – als Schaltfläche bedienbar (Tastatur: src/scripts/barrierefreiheit.js)
const scrollTop = `<div class='eael-ext-scroll-to-top-wrap scroll-to-top-hide'><span class='eael-ext-scroll-to-top-button' role="button" tabindex="0" aria-label="Nach oben"><svg aria-hidden="true" focusable="false" class="e-font-icon-svg e-fas-chevron-up" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg"><path d="M240.971 130.524l194.343 194.343c9.373 9.373 9.373 24.569 0 33.941l-22.667 22.667c-9.357 9.357-24.522 9.375-33.901.04L224 227.495 69.255 381.516c-9.379 9.335-24.544 9.317-33.901-.04l-22.667-22.667c-9.373-9.373-9.373-24.569 0-33.941L207.03 130.525c9.372-9.373 24.568-9.373 33.941-.001z"></path></svg></span></div>`;
---
<!doctype html>
<html lang="de" prefix="og: https://ogp.me/ns#">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {!import.meta.env.PUBLIC_VORSCHAU && <Tracking />}
  <Fragment set:html={seo} />
  <Fragment set:html={jsonLd} />
  <link rel="alternate" type="application/rss+xml" title="thinkfox marketing &raquo; Feed" href="/feed/" />
  {preloadDesktop && <link rel="preload" as="image" href={preloadDesktop} media="(min-width: 768px)" fetchpriority="high" />}
  {preloadMobil && <link rel="preload" as="image" href={preloadMobil} media="(max-width: 767px)" fetchpriority="high" />}
  {heroBilder.map((b) => <link rel="preload" as="image" href={b.href} media={b.media} fetchpriority="high" />)}
  {SCHRIFTEN.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
  {bundle ? (
    <>
      {bundle.ids.map((id) => <style id={id}></style>)}
      {bundle.hrefs.map((href) => <link rel="stylesheet" href={href} media="all" />)}
    </>
  ) : (
    <>
      {stile.map((s) => s.type === 'link'
        ? <link rel="stylesheet" id={s.id ?? undefined} href={s.href} media="all" />
        : <Fragment set:html={s.css} />)}
      <link rel="stylesheet" id="tf-ergaenzungen-css" href={asset('/css/ergaenzungen.css')} media="all" />
      <link rel="stylesheet" id="tf-megamenu-css" href={asset('/css/megamenu.css')} media="all" />
      {einheitlich && <link rel="stylesheet" id="tf-einheitlich-css" href={asset('/css/einheitlich.css')} media="all" />}
    </>
  )}
  {kachelCss && <style id="tf-kacheln-spaet" set:html={kachelCss} />}
  <Fragment set:html={headScripts} />
  <link rel="icon" href="/wp-content/uploads/2026/01/cropped-Logo-Finale_V2-32x32.png" sizes="32x32" />
  <link rel="icon" href="/wp-content/uploads/2026/01/cropped-Logo-Finale_V2-192x192.png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/wp-content/uploads/2026/01/cropped-Logo-Finale_V2-180x180.png" />
  <meta name="msapplication-TileImage" content="/wp-content/uploads/2026/01/cropped-Logo-Finale_V2-270x270.png" />
</head>
<body class={bodyClass}>
  <a class="tf-sprung" href="#content">Zum Inhalt springen</a>
  {!canvas && <Fragment set:html={ohneBildTitel(bildMasse(telefon(zugaenglich(megaMenue(header)))))} />}
  {mitMain ? <Fragment set:html={main} /> : <main id="content"><Fragment set:html={main} /></main>}
  {!canvas && <Fragment set:html={ohneBildTitel(bildMasse(fussEbenen(telefon(footer))))} />}
  {!canvas && <Fragment set:html={scrollTop} />}
  <script src="../scripts/main.js"></script>
  <Fragment set:html={bodyScripts} />
</body>
</html>
