# thinkfox.de – Apache-Konfiguration für die statische Seite (Ausgabe von `npm run build`)

Options -Indexes
DirectoryIndex index.html index.xml index.php
AddDefaultCharset utf-8
# Unbekannte Adressen: echte Fehlerseite (früher: 301 auf die Startseite – für Google ein „Soft 404“)
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # https und ohne www (wie bisher)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://thinkfox.de%{REQUEST_URI} [R=301,L]
  # Übergangsdomain von All-Inkl (…kasserver.com) auf die echte Adresse
  RewriteCond %{HTTP_HOST} kasserver\.com$ [NC]
  RewriteRule ^ https://thinkfox.de%{REQUEST_URI} [R=301,L]

  # Slash am Ende (WordPress-Permalinks)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[a-z0-9]{2,5}$ [NC]
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # Alte WordPress-Archive
  RewriteRule ^author/ /blog/ [R=301,L]
  RewriteRule ^tag/ /blog/ [R=301,L]
  # Alte Adressen aus WordPress (Weiterleitungen, auf die noch Links im Inhalt zeigen)
  RewriteRule ^ganzheitliches-marketing-fuer-nachhaltigen-unternehmenserfolg/$ /deine-externe-marketingabteilung-ganzheitliches-marketing-fuer-den-mittelstand/ [R=301,L]
  RewriteRule ^flyer-anzeigen/$ /category/printproduktion/ [R=301,L]
  RewriteRule ^social-media-mehr-reichweite-sichtbarkeit-fuer-dein-unternehmen/$ /social-media-aus-nordhessen-sichtbarkeit-reichweite/ [R=301,L]
  # /refer/ leitete in WordPress auf die Startseite (Ordner wird nicht mehr benötigt)
  RewriteRule ^refer(/.*)?$ / [R=301,L]
  # Weitere Rank-Math-Weiterleitungen (Export 03.11.2026)
  RewriteRule ^netzwerk-fuer-toleranz/$ /netzwerk-fuer-toleranz-flyer/ [R=301,L]
  RewriteRule ^anfrageseite/$ /thinkfox-marketing-projekt-anfragen/ [R=301,L]
  RewriteRule ^entdecke-das-neue-thinkfox-studio-kreativitaet-trifft-auf-technologie/$ /thinkfox-mietstudio-fuer-foto-und-videoproduktionen-in-nordhessen/ [R=301,L]
  # Selbsttest heißt jetzt „Marketing-Ampel“ („Marketing-Check“ ist das Beratungsangebot). Die Ergebnis-Weiterleitung
  # aus api/config.php (/marketing-check-ergebnis/?ergebnis=…) behält ihren Parameter (Query bleibt bei R=301 erhalten).
  RewriteRule ^thinkfox-marketing-check/$ /marketing-ampel/ [R=301,L]
  RewriteRule ^marketing-check-ergebnis/$ /marketing-ampel/ergebnis/ [R=301,L]
  RewriteRule ^category/allgemein/ /blog/ [R=301,L]
  RewriteRule ^[0-9]{4}/([0-9]{2}/)?([0-9]{2}/)?$ /blog/ [R=301,L]
  # /feed/ liefert feed/index.xml (DirectoryIndex); alte Feed-Varianten dorthin umleiten
  RewriteCond %{REQUEST_URI} !^/feed/index\.xml$
  RewriteRule ^(comments/)?feed/.+ /feed/ [R=301,L]
  RewriteRule ^comments/feed/$ /feed/ [R=301,L]

</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  # HSTS setzt All-Inkl bereits selbst.

  # Content-Security-Policy im Beobachtungsmodus: blockiert nichts, meldet Verstöße an
  # /api/csp-report.php (Ablage api/data/csp.jsonl). Erst nach Auswertung scharf schalten.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.usercentrics.eu https://www.googletagmanager.com https://connect.facebook.net https://cdn.trustindex.io https://www.youtube.com; style-src 'self' 'unsafe-inline' https://cdn.trustindex.io; img-src 'self' data: blob: https:; font-src 'self' data: https://cdn.trustindex.io; media-src 'self' blob:; connect-src 'self' https://*.usercentrics.eu https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.doubleclick.net https://www.google.com https://www.facebook.com https://cdn.trustindex.io https://api.github.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://kuula.co https://crm.thinkfox.marketing https://www.google.com https://www.openstreetmap.org https://www.facebook.com https://td.doubleclick.net; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri /api/csp-report.php"

  # Zwischenspeichern:
  # - Dateien mit Versionskennung (?v=…, siehe src/lib/asset.ts), Build-Dateien mit Hash (/_astro/)
  #   bzw. /_css/ und die eingefrorenen WordPress-Dateien: 1 Jahr
  #   sowie lokal abgelegte Fremddateien mit Hash im Namen (/media/extern/): 1 Jahr
  # - übrige Bilder/Medien (z. B. CMS-Uploads, die überschrieben werden können): 7 Tage
  # - Seiten: jedes Mal beim Server nachfragen (Last-Modified → 304, siehe ETag unten)
  <If "%{QUERY_STRING} =~ /(^|&)v=/ || %{REQUEST_URI} =~ m#^/(_astro|_css|wp-content|wp-includes|media/extern)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#\.(css|js|jpe?g|png|webp|avif|gif|svg|ico|woff2?|ttf|mp4|webm)$#">
    Header set Cache-Control "public, max-age=604800"
  </ElseIf>
  <Else>
    Header set Cache-Control "no-cache"
  </Else>
</IfModule>

# Kein ETag: Apache hängt bei Kompression „-br“/„-gzip“ an, das passt beim Nachfragen nie → immer volle 200-Antwort.
# Ohne ETag prüft der Browser über Last-Modified und bekommt 304 (nur Kopfzeilen).
FileETag None
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

# Übergangsdomain nie indexieren
<If "%{HTTP_HOST} =~ /kasserver\.com$/">
  <IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow"
  </IfModule>
</If>
